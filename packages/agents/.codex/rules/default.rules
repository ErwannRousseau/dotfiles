prefix_rule(
    pattern = ["ssh"],
    decision = "forbidden",
    justification = "SSH commands are forbidden.",
)

prefix_rule(
    pattern = ["scp"],
    decision = "forbidden",
    justification = "SCP commands are forbidden.",
)

prefix_rule(
    pattern = ["sftp"],
    decision = "forbidden",
    justification = "SFTP commands are forbidden.",
)

prefix_rule(
    pattern = ["rtk", "proxy", "ssh"],
    decision = "forbidden",
    justification = "RTK proxy SSH commands are forbidden.",
)

prefix_rule(
    pattern = ["rtk", "proxy", "scp"],
    decision = "forbidden",
    justification = "RTK proxy SCP commands are forbidden.",
)

prefix_rule(
    pattern = ["rtk", "proxy", "sftp"],
    decision = "forbidden",
    justification = "RTK proxy SFTP commands are forbidden.",
)
